@model ImtahanProqrami.Models.Ders
@{
    ViewData["Title"] = "Yeni ders";
}

<h2>Yeni ders</h2>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="DersKodu" class="form-label"></label>
                <input asp-for="DersKodu" class="form-control" maxlength="3" placeholder="RIY" />
                <span asp-validation-for="DersKodu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DersAdi" class="form-label"></label>
                <input asp-for="DersAdi" class="form-control" maxlength="30" />
                <span asp-validation-for="DersAdi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sinif" class="form-label"></label>
                <input asp-for="Sinif" class="form-control" type="number" min="1" max="11" />
                <span asp-validation-for="Sinif" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MuellimAdi" class="form-label"></label>
                <input asp-for="MuellimAdi" class="form-control" maxlength="20" />
                <span asp-validation-for="MuellimAdi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MuellimSoyadi" class="form-label"></label>
                <input asp-for="MuellimSoyadi" class="form-control" maxlength="20" />
                <span asp-validation-for="MuellimSoyadi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Yadda saxla</button>
            <a asp-action="Index" class="btn btn-link">Geri</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
