@model ImtahanProqrami.Models.Imtahan
@{
    ViewData["Title"] = "Yeni imtahan";
}

<h2>Yeni imtahan</h2>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="DersKodu" class="form-label"></label>
                <select asp-for="DersKodu" asp-items="ViewBag.Dersler" class="form-select">
                    <option value="">-- sec --</option>
                </select>
                <span asp-validation-for="DersKodu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SagirdNomresi" class="form-label"></label>
                <select asp-for="SagirdNomresi" asp-items="ViewBag.Sagirdler" class="form-select">
                    <option value="">-- sec --</option>
                </select>
                <span asp-validation-for="SagirdNomresi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImtahanTarixi" class="form-label"></label>
                <input asp-for="ImtahanTarixi" class="form-control" type="date" />
                <span asp-validation-for="ImtahanTarixi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Qiymet" class="form-label"></label>
                <select asp-for="Qiymet" class="form-select">
                    <option value="">sonra qoyulacaq</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
                <span asp-validation-for="Qiymet" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Yadda saxla</button>
            <a asp-action="Index" class="btn btn-link">Geri</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
