@model ImtahanProqrami.Models.Imtahan
@{
    ViewData["Title"] = "Qiymet";
}

<h2>Qiymetin qoyulmasi</h2>

<dl class="row">
    <dt class="col-sm-3">Ders</dt>
    <dd class="col-sm-9">@Model.Ders?.DersAdi</dd>

    <dt class="col-sm-3">Sagird</dt>
    <dd class="col-sm-9">@Model.Sagird?.Adi @Model.Sagird?.Soyadi</dd>

    <dt class="col-sm-3">Tarix</dt>
    <dd class="col-sm-9">@Model.ImtahanTarixi.ToString("dd.MM.yyyy")</dd>
</dl>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="dersKodu" value="@Model.DersKodu" />
            <input type="hidden" name="sagirdNomresi" value="@Model.SagirdNomresi" />
            <input type="hidden" name="tarix" value="@Model.ImtahanTarixi.ToString("yyyy-MM-dd")" />

            <div class="mb-3">
                <label class="form-label">Qiymet</label>
                <select name="qiymet" class="form-select">
                    <option value="" selected="@(Model.Qiymet is null)">qoyulmayib</option>
                    @foreach (short deyer in new short[] { 2, 3, 4, 5 })
                    {
                        <option value="@deyer" selected="@(Model.Qiymet == deyer)">@deyer</option>
                    }
                </select>
                <span asp-validation-for="Qiymet" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Yadda saxla</button>
            <a asp-action="Index" class="btn btn-link">Geri</a>
        </form>
    </div>
</div>
