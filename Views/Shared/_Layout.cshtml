<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Imtahan proqrami</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Imtahan proqrami</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dersler" asp-action="Index">Dersler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Sagirdler" asp-action="Index">Sagirdler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Imtahanlar" asp-action="Index">Imtahanlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Hesabatlar" asp-action="Index">Hesabatlar</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success">@TempData["Mesaj"]</div>
        }
        @if (TempData["Xeta"] != null)
        {
            <div class="alert alert-danger">@TempData["Xeta"]</div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">Orta mekteb - imtahan neticelerinin qeydiyyati</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
